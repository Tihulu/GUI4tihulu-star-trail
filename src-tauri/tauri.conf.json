{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tihulu Star Trail Studio",
  "version": "0.2.1",
  "identifier": "io.github.tihulu.gui4startrail",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tihulu Star Trail Studio",
        "width": 1240,
        "height": 900,
        "minWidth": 760,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "backgroundColor": "#070912"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Photography",
    "shortDescription": "Modern desktop GUI for tihulu-star-trail",
    "longDescription": "Review, curate, group and render night-sky photos with the installed tihulu-star-trail engine, including direct access to the full upstream desktop and web workspaces.",
    "copyright": "Copyright © Tihulu contributors",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
